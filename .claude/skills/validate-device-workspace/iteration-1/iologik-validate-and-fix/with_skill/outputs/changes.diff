+def test_unsupported_identity_register_does_not_fault(made, monkeypatch):
+    """C1/B2: a unit refusing an identity register still initializes, healthy."""
+    original = io_api.ModbusTcpClient
+
+    def no_firmware_register(*args, **kwargs):
+        client = original(*args, **kwargs)
+        client.refuse.add(io_api.IoLogikE1212Api._ADDR_FIRMWARE_VERSION)
+        return client
+
+    monkeypatch.setattr(io_api, "ModbusTcpClient", no_firmware_register)
+    dev = IoLogikE1212("127.0.0.1", name="io_old_fw")
+    dev.initialize()
+    assert dev.ready and not dev.faulted
+    assert dev.info["model_name"] == "ioLogik E1212"
+    assert dev.info["firmware_version"] is None
+    dev.shutdown()
+
+
+def test_initialize_fails_when_the_unit_never_answers(made, monkeypatch):
+    """C1: the TCP connect succeeds (something listens on 502) but no Modbus
+    reply comes: initialize must raise and leave the device faulted."""
+    original = io_api.ModbusTcpClient
+
+    def silent(*args, **kwargs):
+        client = original(*args, **kwargs)
+        client.fail_with = ModbusIOException("No response received after 3 retries")
+        return client
+
+    monkeypatch.setattr(io_api, "ModbusTcpClient", silent)
+    dev = IoLogikE1212("127.0.0.1", name="io_silent")
+    with pytest.raises(ModbusException):
+        dev.initialize()
+    assert dev.faulted and not dev.connected
+    dev.shutdown()
+
