diff --git a/tests/test_iologik_e1212.py b/tests/test_iologik_e1212.py
new file mode 100644
index 0000000..a219fd4
--- /dev/null
+++ b/tests/test_iologik_e1212.py
@@ -0,0 +1,404 @@
+"""IoLogikE1212 driver and its Modbus API module, against a fake pymodbus client.
+
+No hardware and no socket: ``devices.api.IoLogikE1212Api.ModbusTcpClient`` is
+replaced by :class:`FakeModbusClient`, which behaves like pymodbus 3.12's sync
+client: ``connect()`` returns a bool, ``is_socket_open()`` is ``socket is not
+None``, link failures raise ``ConnectionException`` (peer closed the socket,
+which pymodbus then drops) or ``ModbusIOException`` (no reply in time, socket
+left open), and a refused request returns an ``ExceptionResponse``.
+"""
+
+import json
+import threading
+import time
+
+import pytest
+from pymodbus.exceptions import ConnectionException, ModbusException, ModbusIOException
+from pymodbus.pdu import ExceptionResponse
+
+import devices.api.IoLogikE1212Api as io_api
+from devices.IoLogikE1212 import IoLogikE1212
+from devices.registry import create_device, validate_devices_config
+
+# Calls that change an output, a counter or a pulse on the unit.
+WRITES = {"write_coil", "write_coils", "write_register", "write_registers"}
+IO_CALLS = WRITES | {"read_coils", "read_discrete_inputs", "read_input_registers",
+                     "read_holding_registers"}
+
+
+class _Result:
+    def __init__(self, bits=None, registers=None):
+        self.bits = list(bits or [])
+        self.registers = list(registers or [])
+
+    def isError(self):
+        return False
+
+
+def _ascii_words(text, words):
+    raw = text.encode("ascii").ljust(words * 2, b"\x00")
+    return [(raw[i] << 8) | raw[i + 1] for i in range(0, words * 2, 2)]
+
+
+class FakeModbusClient:
+    """Stands in for pymodbus.client.ModbusTcpClient (sync). Logs every call."""
+
+    def __init__(self, host, port=502, **kwargs):
+        self.host, self.port, self.kwargs = host, port, kwargs
+        self.calls = []                 # (name, args, kwargs)
+        self.socket = None
+        self.connect_ok = True
+        self.fail_with = None           # exception raised by the next I/O call
+        self.refuse = set()             # addresses answered with an ExceptionResponse
+        self.di = [False] * 16
+        self.coils = [False] * 8
+        self.input_registers = {}
+        self.input_registers.update(enumerate(_ascii_words("ioLogik E1212", 10), start=5000))
+        self.input_registers.update({5027: (192 << 8) | 168, 5028: (127 << 8) | 254,
+                                     5029: (3 << 8) | 2, 5030: (1 << 8)})
+
+    # --- connection ---
+    def connect(self):
+        self.calls.append(("connect", (), {}))
+        if self.socket is None and self.connect_ok:
+            self.socket = object()
+        return self.socket is not None
+
+    def close(self):
+        self.calls.append(("close", (), {}))
+        self.socket = None
+
+    def is_socket_open(self):
+        return self.socket is not None
+
+    # --- I/O ---
+    def _io(self, name, address, *args, **kwargs):
+        self.calls.append((name, (address,) + args, kwargs))
+        # pymodbus' execute() reconnects on its own when the socket is closed.
+        if self.socket is None and not self.connect():
+            raise ConnectionException("Failed to connect")
+        if self.fail_with is not None:
+            exc, self.fail_with = self.fail_with, None
+            if isinstance(exc, ConnectionException):
+                self.socket = None      # pymodbus drops a socket the peer closed
+            raise exc
+        if address in self.refuse:
+            return ExceptionResponse(0x02, 2)      # illegal data address
+        return None
+
+    def read_discrete_inputs(self, address, *, count=1, device_id=1, **kw):
+        return self._io("read_discrete_inputs", address, count=count, device_id=device_id) \
+            or _Result(bits=self.di[address:address + count] + [False] * 8)
+
+    def read_coils(self, address, *, count=1, device_id=1, **kw):
+        return self._io("read_coils", address, count=count, device_id=device_id) \
+            or _Result(bits=self.coils[address:address + count] + [False] * 8)
+
+    def read_input_registers(self, address, *, count=1, device_id=1, **kw):
+        return self._io("read_input_registers", address, count=count, device_id=device_id) \
+            or _Result(registers=[self.input_registers.get(a, 0) for a in range(address, address + count)])
+
+    def write_coil(self, address, value, *, device_id=1, **kw):
+        rsp = self._io("write_coil", address, value, device_id=device_id)
+        if rsp is None and address < len(self.coils):
+            self.coils[address] = bool(value)
+        return rsp or _Result()
+
+    def write_coils(self, address, values, *, device_id=1, **kw):
+        rsp = self._io("write_coils", address, list(values), device_id=device_id)
+        if rsp is None:
+            self.coils[address:address + len(values)] = [bool(v) for v in values]
+        return rsp or _Result()
+
+    def write_register(self, address, value, *, device_id=1, **kw):
+        return self._io("write_register", address, value, device_id=device_id) or _Result()
+
+    # helpers for assertions
+    def names(self):
+        return [c[0] for c in self.calls]
+
+
+@pytest.fixture
+def made(monkeypatch):
+    """Every FakeModbusClient the API created; ``made[-1]`` is the live one."""
+    clients = []
+
+    def factory(*args, **kwargs):
+        clients.append(FakeModbusClient(*args, **kwargs))
+        return clients[-1]
+
+    monkeypatch.setattr(io_api, "ModbusTcpClient", factory)
+    return clients
+
+
+@pytest.fixture
+def io(made):
+    dev = IoLogikE1212("127.0.0.1", name="io_test")
+    yield dev
+    dev.shutdown()
+
+
+def _io_calls(client):
+    return [c for c in client.calls if c[0] in IO_CALLS]
+
+
+# --- Registry and construction ------------------------------------------------
+
+def test_registry_validates_and_creates_without_connecting(made):
+    entries, issues = validate_devices_config(
+        {"io": {"type": "iologik", "ip_address": "10.0.0.2", "port": "5020"}})
+    assert issues == []
+    assert entries[0].kwargs == {"ip_address": "10.0.0.2", "port": 5020, "slave_id": 1}
+    dev = create_device(entries[0])
+    assert dev.device_id == "io"
+    assert not dev.connected and not dev.ready
+    assert all(name != "connect" for c in made for name in c.names())
+
+    entries, issues = validate_devices_config({"io": {"type": "iologik"}})
+    assert entries == [] and "missing required 'ip_address'" in issues[0]["message"]
+
+
+# --- Initialize and identity --------------------------------------------------
+
+def test_initialize_reads_identity(io, made):
+    io.initialize()
+    assert io.connected and io.ready and not io.faulted
+    info = io.info
+    assert info["model_name"] == "ioLogik E1212"
+    assert info["firmware_version"] == "V3.2.1"
+    assert info["lan_ip"] == "192.168.127.254"
+    json.dumps(info)
+    # The identity reads are the only traffic: nothing written at startup.
+    assert not [c for c in made[-1].calls if c[0] in WRITES]
+
+
+def test_initialize_failure_raises_and_faults(made, monkeypatch):
+    dev = IoLogikE1212("127.0.0.1", name="io_dead")
+    original = io_api.ModbusTcpClient
+
+    def unreachable(*args, **kwargs):
+        client = original(*args, **kwargs)
+        client.connect_ok = False
+        return client
+
+    monkeypatch.setattr(io_api, "ModbusTcpClient", unreachable)
+    with pytest.raises(Exception):
+        dev.initialize()
+    assert dev.faulted and not dev.connected and not dev.ready
+
+
+# --- Public surface task code relies on ---------------------------------------
+
+def test_task_api_write_do_and_read_all_di_unchanged(made):
+    dev = IoLogikE1212("127.0.0.1", slave_id=3, name="io_api")
+    dev.initialize()
+    client = made[-1]
+    client.di[2] = True
+
+    dev.api.write_do(5, True)
+    assert ("write_coil", (5, True), {"device_id": 3}) in client.calls
+    assert dev.api.read_do(5) is True
+
+    states = dev.api.read_all_di()
+    assert states == [False, False, True, False, False, False, False, False]
+    assert all(type(s) is bool for s in states)
+    with pytest.raises(ValueError):
+        dev.api.write_do(8, True)
+    dev.shutdown()
+
+
+# --- Live I/O panel ------------------------------------------------------------
+
+def test_io_points_and_write_io(io, made):
+    assert io.io_points() == []
+    io.initialize()
+    points = io.io_points()
+    json.dumps(points)
+    assert [p["name"] for p in points] == [f"di{i}" for i in range(8)] + [f"do{i}" for i in range(8)]
+    assert all(set(p) == {"name", "kind", "value", "writable"} for p in points)
+    assert all(p["writable"] is (p["kind"] == "do") for p in points)
+
+    io.write_io("do3", 1)
+    assert made[-1].coils[3] is True
+    for bad in ("di0", "do8", "ao0", "do", "x"):
+        with pytest.raises(ValueError):
+            io.write_io(bad, True)
+
+
+# --- Lifecycle -----------------------------------------------------------------
+
+def test_shutdown_is_safe_when_never_connected_and_twice(made):
+    dev = IoLogikE1212("127.0.0.1", name="io_never")
+    dev.shutdown()
+    dev.shutdown()
+    assert not dev.connected
+
+
+def test_disconnect_then_connect(io, made):
+    io.initialize()
+    io.disconnect()
+    assert not io.connected
+    io.connect()
+    assert io.ready and len(made) == 2
+    assert io.api.read_all_di() == [False] * 8
+
+
+def test_abort_shutdown_and_clear_fault_never_switch_outputs(io, made):
+    io.abort()                              # never connected: must not raise
+    io.initialize()
+    io.abort()
+    io.clear_fault()
+    io.shutdown()
+    assert not [c for client in made for c in client.calls if c[0] in WRITES]
+
+
+# --- Added by validate-device ---------------------------------------------------
+
+def test_status_properties_never_touch_the_device(io, made):
+    io.initialize()
+    before = len(_io_calls(made[-1]))
+    for _ in range(20):
+        io.faulted, io.ready, io.connected, io.info, io.link
+    assert len(_io_calls(made[-1])) == before
+
+
+def test_status_properties_dont_wait_for_a_task_exchange(io, made):
+    """A1: a Modbus call can block for timeout x (retries + 1) = 12 s by default.
+    The fault monitor must not queue behind it."""
+    io.initialize()
+    lock = io.api._client._lock         # the lock _SerializedClient takes per call
+    held, release = threading.Event(), threading.Event()
+
+    def long_exchange():
+        with lock:
+            held.set()
+            release.wait(2)
+
+    worker = threading.Thread(target=long_exchange)
+    worker.start()
+    assert held.wait(1)
+    try:
+        started = time.monotonic()
+        result = {}
+        reader = threading.Thread(
+            target=lambda: result.update(v=(io.faulted, io.ready, io.connected, io.info)))
+        reader.start()
+        reader.join(0.5)
+        assert not reader.is_alive(), "status read blocked behind the session lock"
+        assert time.monotonic() - started < 0.1
+    finally:
+        release.set()
+        worker.join()
+        reader.join()
+
+
+def test_no_reply_latches_fault_with_reason(io, made):
+    """B1/B3: cable pulled. pymodbus times out (ModbusIOException) and keeps
+    the socket open, so 'socket open' says nothing about the link."""
+    io.initialize()
+    made[-1].fail_with = ModbusIOException("No response received after 3 retries")
+    with pytest.raises(ModbusException):
+        io.api.write_do(0, True)
+    assert io.faulted and not io.ready and not io.connected
+    assert "No response" in (getattr(io, "_fault", None) or "")
+
+
+def test_link_drop_fault_stays_latched_until_cleared(io, made):
+    """B1: after the peer closes the socket, pymodbus reconnects on the next
+    call by itself. The fault must stay latched until Clear faults."""
+    io.initialize()
+    made[-1].fail_with = ConnectionException("Connection unexpectedly closed")
+    with pytest.raises(ModbusException):
+        io.api.read_all_di()
+    assert io.faulted
+    io.api.read_all_di()                    # silently reconnects in pymodbus
+    assert io.faulted and not io.ready
+
+
+def test_clear_fault_reopens_the_session_without_writing(io, made):
+    """B4: Clear faults must give a fresh session, not only drop the flag."""
+    io.initialize()
+    made[-1].fail_with = ModbusIOException("No response received after 3 retries")
+    with pytest.raises(ModbusException):
+        io.api.read_all_di()
+    sessions = len(made)
+
+    io.clear_fault()
+    assert not io.faulted and io.ready
+    assert len(made) == sessions + 1
+    assert made[-2].socket is None          # the stale session was closed
+    assert io.api.read_all_di() == [False] * 8
+    assert not [c for client in made for c in client.calls if c[0] in WRITES]
+
+    # Not faulted: clear_fault is a no-op, no new session.
+    io.clear_fault()
+    assert len(made) == sessions + 1
+
+
+def test_clear_fault_after_socket_closed_recovers(io, made):
+    """B4: the peer closed the socket. Clear faults must bring the device
+    back without needing a task call first."""
+    io.initialize()
+    made[-1].fail_with = ConnectionException("Connection unexpectedly closed")
+    with pytest.raises(ModbusException):
+        io.api.read_all_di()
+    io.clear_fault()
+    assert not io.faulted and io.ready
+
+
+def test_refused_command_is_not_a_fault(io, made):
+    """B2: the unit answering with a Modbus exception (bad address, ...) is
+    the task's error, not a dead device."""
+    io.initialize()
+    made[-1].refuse.add(io.api._ADDR_DO_STATUS + 2)
+    with pytest.raises(ModbusException):
+        io.api.write_do(2, True)
+    assert not io.faulted and io.ready
+    assert io.api.read_all_di() == [False] * 8
+
