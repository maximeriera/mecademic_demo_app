+def test_api_closes_the_session_on_a_link_error(io, made):
+    """E3: after a timeout the late reply must not be read as the next answer,
+    so the API drops the session before re-raising."""
+    io.initialize()
+    client = made[-1]
+    client.fail_with = ModbusIOException("No response received after 3 retries")
+    with pytest.raises(ModbusException):
+        io.api.read_all_do()
+    assert "close" in client.names()
