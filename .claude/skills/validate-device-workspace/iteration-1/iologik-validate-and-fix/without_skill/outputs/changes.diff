@@ -0,0 +1,327 @@
+"""Moxa ioLogik E1212 driver, hardware-free: a fake ModbusTcpClient stands in for the unit."""
+
+import threading
+from types import SimpleNamespace
+
+import pytest
+from pymodbus.exceptions import ConnectionException, ModbusException, ModbusIOException
+
+import devices.api.IoLogikE1212Api as api_module
+from devices.IoLogikE1212 import IoLogikE1212
+from devices.api.IoLogikE1212Api import IoLogikE1212Api
+from devices.registry import create_device, validate_devices_config
+
+
+class FakeModbusClient:
+    """Mimics the parts of pymodbus' sync ModbusTcpClient the driver uses.
+
+    Like the real client, every request first (re)connects when the socket is
+    closed, transport failures are *raised* (ModbusIOException /
+    ConnectionException), and Modbus exception codes come back as a response
+    whose ``isError()`` is True.
+    """
+
+    instances = []
+
+    def __init__(self, host, port=502, timeout=3, retries=3, **_):
+        self.host, self.port, self.timeout, self.retries = host, port, timeout, retries
+        self.reachable = True
+        self.socket_open = False
+        self.raise_on_request = None      # exception raised by every request
+        self.error_response = False       # requests return an exception response
+        self.coils, self.discrete, self.input_regs, self.holding = {}, {}, {}, {}
+        self.calls = []
+        FakeModbusClient.instances.append(self)
+
+    # --- connection ---------------------------------------------------
+    def connect(self):
+        if not self.socket_open:
+            self.socket_open = self.reachable
+        return self.socket_open
+
+    def close(self):
+        self.socket_open = False
+
+    def is_socket_open(self):
+        return self.socket_open
+
+    # --- requests -----------------------------------------------------
+    def _request(self, name, address, device_id, **kw):
+        self.calls.append((name, address, device_id, kw))
+        if not self.connect():
+            raise ConnectionException("Failed to connect")
+        if self.raise_on_request is not None:
+            raise self.raise_on_request
+        return SimpleNamespace(isError=lambda: self.error_response)
+
+    @staticmethod
+    def _bits(table, address, count):
+        bits = [bool(table.get(address + i, False)) for i in range(count)]
+        return bits + [False] * (-len(bits) % 8)      # pymodbus pads to a byte
+
+    def read_discrete_inputs(self, address, *, count=1, device_id=1):
+        rsp = self._request("read_discrete_inputs", address, device_id, count=count)
+        rsp.bits = self._bits(self.discrete, address, count)
+        return rsp
+
+    def read_coils(self, address, *, count=1, device_id=1):
+        rsp = self._request("read_coils", address, device_id, count=count)
+        rsp.bits = self._bits(self.coils, address, count)
+        return rsp
+
+    def read_input_registers(self, address, *, count=1, device_id=1):
+        rsp = self._request("read_input_registers", address, device_id, count=count)
+        rsp.registers = [self.input_regs.get(address + i, 0) for i in range(count)]
+        return rsp
+
+    def write_coil(self, address, value, *, device_id=1):
+        rsp = self._request("write_coil", address, device_id, value=value)
+        if not self.error_response:
+            self.coils[address] = bool(value)
+        return rsp
+
+    def write_coils(self, address, values, *, device_id=1):
+        rsp = self._request("write_coils", address, device_id, values=list(values))
+        if not self.error_response:
+            for i, v in enumerate(values):
+                self.coils[address + i] = bool(v)
+        return rsp
+
+    def write_register(self, address, value, *, device_id=1):
+        rsp = self._request("write_register", address, device_id, value=value)
+        if not self.error_response:
+            self.holding[address] = value
+        return rsp
+
+
+@pytest.fixture(autouse=True)
+def fake_modbus(monkeypatch):
+    FakeModbusClient.instances = []
+    monkeypatch.setattr(api_module, "ModbusTcpClient", FakeModbusClient)
+    yield
+
+
+def _connected_io(**kwargs):
+    io = IoLogikE1212("10.0.0.2", name="test_iologik", **kwargs)
+    io.initialize()
+    return io, FakeModbusClient.instances[-1]
+
+
+# --- Task API used by workspaces: must keep working unchanged -------------
+
+def test_task_api_write_do_and_read_all_di_unchanged():
+    io, fake = _connected_io(slave_id=3)
+    fake.discrete.update({0: True, 5: True})
+
+    io.api.write_do(2, True)
+    assert fake.coils[2] is True
+    assert fake.calls[-1][:3] == ("write_coil", 2, 3)
+    assert io.api.read_do(2) is True
+
+    states = io.api.read_all_di()
+    assert isinstance(states, list) and len(states) == IoLogikE1212Api.DI_COUNT == 8
+    assert states == [True, False, False, False, False, True, False, False]
+    assert io.api.read_di(5) is True
+
+    io.api.write_all_do([True] * 8)
+    assert io.api.read_all_do() == [True] * 8
+    assert io.ready and not io.faulted
+
+
+def test_io_points_and_write_io():
+    io, fake = _connected_io()
+    fake.discrete[1] = True
+    io.write_io("do4", True)
+    points = {p["name"]: p for p in io.io_points()}
+    assert points["di1"]["value"] is True and not points["di1"]["writable"]
+    assert points["do4"]["value"] is True and points["do4"]["writable"]
+    with pytest.raises(ValueError):
+        io.write_io("di0", True)
+    with pytest.raises(ValueError):
+        io.write_io("do8", True)
+
+
+def test_channel_validation():
+    io, _ = _connected_io()
+    for bad in (8, -1, 1.5, "1"):
+        with pytest.raises(ValueError):
+            io.api.write_do(bad, True)
+    with pytest.raises(ValueError):
+        io.api.read_di(8)
+    with pytest.raises(ValueError):
+        io.api.write_all_do([True] * 7)
+
+
+# --- Fault detection -------------------------------------------------------
+
+def test_transport_failure_faults_the_device():
+    """A cable pull makes pymodbus *raise* ModbusIOException; it must not look healthy."""
+    io, fake = _connected_io()
+    fake.raise_on_request = ModbusIOException("No response received after 3 retries")
+    with pytest.raises(ModbusException):
+        io.api.read_all_di()
+    assert io.faulted
+    assert not io.ready
+
+
+def test_dropped_socket_faults_the_device():
+    io, fake = _connected_io()
+    fake.raise_on_request = ConnectionException("Connection unexpectedly closed")
+    with pytest.raises(ModbusException):
+        io.api.write_do(0, True)
+    assert io.faulted
+
+
+@pytest.mark.parametrize("call", [
+    lambda a: a.start_di_counter(0),
+    lambda a: a.stop_di_counter(0),
+    lambda a: a.reset_di_counter(0),
+    lambda a: a.clear_di_counter_overflow(0),
+    lambda a: a.configure_do_pulse(0, 100, 100, 3),
+    lambda a: a.start_do_pulse(0),
+    lambda a: a.stop_do_pulse(0),
+    lambda a: a.clear_watchdog_alarm(),
+])
+def test_write_commands_check_the_response(call):
+    io, fake = _connected_io()
+    fake.error_response = True
+    with pytest.raises(ModbusException):
+        call(io.api)
+    assert io.faulted
+
+
+def test_health_never_waits_for_an_in_flight_request():
+    """The 200 ms monitor reads ``faulted``; a hung request must not block it."""
+    io, _ = _connected_io()
+    client = io.api._client
+    holding = threading.Event()
+    release = threading.Event()
+
+    def hold_lock():
+        with client._lock:
+            holding.set()
+            release.wait(5)
+
+    t = threading.Thread(target=hold_lock, daemon=True)
+    t.start()
+    holding.wait(1)
+    try:
+        result = {}
+        reader = threading.Thread(
+            target=lambda: result.update(f=io.faulted, c=io.connected, r=io.ready), daemon=True)
+        reader.start()
+        reader.join(0.5)
+        assert not reader.is_alive(), "faulted/connected/ready blocked behind the Modbus lock"
+        assert result == {"f": False, "c": True, "r": True}
+    finally:
+        release.set()
+        t.join(1)
+
+
+# --- Lifecycle -------------------------------------------------------------
+
+def test_calls_before_initialize_raise_a_connection_error():
+    io = IoLogikE1212("10.0.0.2", name="test_iologik_cold")
+    with pytest.raises(ConnectionException):
+        io.api.write_do(0, True)
+    with pytest.raises(ConnectionException):
+        io.api.read_all_di()
+    assert io.faulted and not io.connected
+    assert io.io_points() == []
+    io.shutdown()                                   # safe before initialize
+    io.shutdown()
+
+
+def test_failed_connect_raises_and_releases_the_client(monkeypatch):
+    class Unreachable(FakeModbusClient):
+        def __init__(self, *a, **kw):
+            super().__init__(*a, **kw)
+            self.reachable = False
+
+    monkeypatch.setattr(api_module, "ModbusTcpClient", Unreachable)
+    io = IoLogikE1212("10.0.0.2", name="test_iologik_down")
+    with pytest.raises(ConnectionError):
+        io.initialize()
+    assert io.faulted and not io.connected
+    assert io.api._client is None
+
+
+def test_initialize_fails_when_the_unit_does_not_answer(monkeypatch):
+    class Silent(FakeModbusClient):
+        def __init__(self, *a, **kw):
+            super().__init__(*a, **kw)
+            self.raise_on_request = ModbusIOException("No response received")
+
+    monkeypatch.setattr(api_module, "ModbusTcpClient", Silent)
+    io = IoLogikE1212("10.0.0.2", name="test_iologik_silent")
+    with pytest.raises(ModbusException):
+        io.initialize()
+    assert io.faulted and not io.ready
+
+
+def test_refused_identity_register_does_not_fault_initialize(monkeypatch):
+    class NoIdentity(FakeModbusClient):
+        def read_input_registers(self, address, *, count=1, device_id=1):
+            rsp = super().read_input_registers(address, count=count, device_id=device_id)
+            rsp.isError = lambda: True          # illegal data address
+            return rsp
+
+    monkeypatch.setattr(api_module, "ModbusTcpClient", NoIdentity)
+    io = IoLogikE1212("10.0.0.2", name="test_iologik_noid")
+    io.initialize()
+    assert io.ready and not io.faulted
+    assert io.info["model_name"] is None
+
+
+def test_clear_fault_only_clears_when_the_unit_answers():
+    io, fake = _connected_io()
+    fake.raise_on_request = ModbusIOException("No response")
+    with pytest.raises(ModbusException):
+        io.api.read_all_di()
+    assert io.faulted
+
+    # Unit still unreachable: clearing must fail and leave the fault latched.
+    fake.raise_on_request = None
+    fake.reachable = False
+    fake.socket_open = False
+    with pytest.raises(Exception):
+        io.clear_fault()
+    assert io.faulted
+
+    # Unit back: clear_fault reconnects, probes and clears.
+    fake.reachable = True
+    io.clear_fault()
+    assert not io.faulted and io.ready and io.connected
+
+
+def test_reconnect_after_disconnect():
+    io, _ = _connected_io()
+    assert io.supports_reconnect
+    io.disconnect()
+    assert not io.connected and io.faulted
+    io.connect()
+    assert io.connected and io.ready
+    io.api.write_do(0, True)
+
+
+def test_timeout_and_retries_reach_the_client_and_are_bounded_by_default():
+    _connected_io(timeout=0.5, retries=0)
+    fake = FakeModbusClient.instances[-1]
+    assert (fake.timeout, fake.retries) == (0.5, 0)
+
+    _connected_io()
+    fake = FakeModbusClient.instances[-1]
+    # Worst-case wait on a dead unit, per call, with the defaults.
+    assert fake.timeout * (fake.retries + 1) <= 5
+
+
+def test_registry_entry_builds_the_driver():
+    entries, issues = validate_devices_config({
+        "io": {"type": "iologik", "ip_address": "10.0.0.2", "timeout": "0.5", "retries": 0},
+    })
+    assert issues == []
+    io = create_device(entries[0])
+    assert isinstance(io, IoLogikE1212)
+    io.initialize()
+    fake = FakeModbusClient.instances[-1]
+    assert (fake.host, fake.port, fake.timeout, fake.retries) == ("10.0.0.2", 502, 0.5, 0)
