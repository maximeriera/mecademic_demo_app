diff --git a/tests/test_planar_motor.py b/tests/test_planar_motor.py
new file mode 100644
index 0000000..b17f9c1
--- /dev/null
+++ b/tests/test_planar_motor.py
@@ -0,0 +1,203 @@
+"""PlanarMotor driver without a PMC: a fake pmclib system/xbot layer.
+
+The status properties (``faulted`` / ``ready`` / ``connected``) are read by the
+controller's monitor thread at 5 Hz and by the LivePublisher thread that also
+feeds the 10 Hz ``status`` stream. They must answer from cached state and never
+wait on the PMC, or one slow controller stalls the UI and delays fault
+detection on every other device.
+"""
+
+import sys
+import threading
+import time
+import types
+from enum import IntEnum
+
+import pytest
+
+
+def _install_fake_pmclib():
+    """Stand-in for pmclib on machines where the .NET DLL cannot load."""
+
+    class PMCSTATUS(IntEnum):
+        PMC_UNKNOWN = -1
+        PMC_BOOTING = 0
+        PMC_INACTIVE = 1
+        PMC_ACTIVATING = 2
+        PMC_DISCOVERY = 3
+        PMC_SERVICE = 4
+        PMC_FULLCTRL = 5
+        PMC_INTELLIGENTCTRL = 6
+        PMC_DEACTIVATING = 7
+        PMC_ERRORHANDLING = 8
+        PMC_ERROR = 9
+
+    pkg = types.ModuleType("pmclib")
+    pmc_types = types.ModuleType("pmclib.pmc_types")
+    pmc_types.PMCSTATUS = PMCSTATUS
+    # Other enums only appear in annotations here: any placeholder type will do.
+    pmc_types.__getattr__ = lambda name: type(name, (), {})
+    pkg.pmc_types = pmc_types
+    pkg.system_commands = types.ModuleType("pmclib.system_commands")
+    pkg.xbot_commands = types.ModuleType("pmclib.xbot_commands")
+    sys.modules.update({
+        "pmclib": pkg,
+        "pmclib.pmc_types": pmc_types,
+        "pmclib.system_commands": pkg.system_commands,
+        "pmclib.xbot_commands": pkg.xbot_commands,
+    })
+
+
+try:
+    import pmclib  # noqa: F401  (real library, Windows + pythonnet)
+except Exception:
+    _install_fake_pmclib()
+
+from devices.api import PlanarMotorApi as api_mod  # noqa: E402
+from devices.PlanarMotor import PlanarMotor  # noqa: E402
+
+PMCSTATUS = api_mod.pmc_types.PMCSTATUS
+
+
+class FakeSys:
+    """pmclib.system_commands: one PMC whose status the test controls."""
+
+    def __init__(self):
+        self.status = PMCSTATUS.PMC_FULLCTRL
+        self.status_calls = 0
+        self.raise_on_status = None
+        self.gate = threading.Event()   # cleared = status call hangs (PMC not answering)
+        self.gate.set()
+
+    def connect_to_specific_pmc(self, ip):
+        return True
+
+    def auto_search_and_connect_to_pmc(self):
+        return True
+
+    def is_master(self):
+        return True
+
+    def gain_mastership(self):
+        pass
+
+    def get_pmc_status(self):
+        self.status_calls += 1
+        self.gate.wait(5)
+        if self.raise_on_status:
+            raise self.raise_on_status
+        return self.status
+
+    def disconnect_from_pmc(self):
+        pass
+
+
+class FakeBot:
+    def __init__(self, pmc):
+        self.pmc = pmc
+
+    def activate_xbots(self):
+        self.pmc.status = PMCSTATUS.PMC_FULLCTRL
+
+    def deactivate_xbots(self):
+        self.pmc.status = PMCSTATUS.PMC_INACTIVE
+
+
+def wait_for(predicate, timeout=3.0):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(0.01)
+    raise AssertionError("condition not met within %.1fs" % timeout)
+
+
+@pytest.fixture
+def pmc():
+    return FakeSys()
+
+
+@pytest.fixture
+def device(pmc, monkeypatch):
+    monkeypatch.setattr(api_mod.PlanarMotorApi, "HEALTH_POLL_S", 0.02, raising=False)
+    dev = PlanarMotor(ip_address="192.0.2.10", name="planar_test")
+    dev.api.sys = pmc
+    dev.api.bot = FakeBot(pmc)
+    yield dev
+    pmc.gate.set()
+    dev.shutdown()
+
+
+def test_status_reads_do_not_wait_on_the_pmc(device, pmc):
+    device.initialize()
+    assert device.ready and not device.faulted
+
+    pmc.gate.clear()   # PMC stops answering: every status call now blocks
+    try:
+        start = time.monotonic()
+        for _ in range(20):   # 4 s of monitor loop + SSE ticks
+            device.faulted
+            device.ready
+            device.connected
+            assert time.monotonic() - start < 0.2, "a status read waited on the PMC"
+    finally:
+        pmc.gate.set()
+
+
+def test_status_reads_are_not_one_round_trip_each(device, pmc):
+    device.initialize()
+    pmc.status_calls = 0
+    for _ in range(100):
+        device.faulted
+        device.ready
+    # The background poller may run a few times meanwhile, never 200.
+    assert pmc.status_calls < 20
+
+
+def test_pmc_error_is_picked_up_and_cleared(device, pmc):
+    device.initialize()
+    pmc.status = PMCSTATUS.PMC_ERROR
+    wait_for(lambda: device.faulted)
+    assert not device.ready
+
+    pmc.status = PMCSTATUS.PMC_FULLCTRL
+    device.clear_fault()
+    assert not device.faulted
+    assert device.ready
+
+
+def test_status_exception_faults(device, pmc):
+    device.initialize()
+    pmc.raise_on_status = RuntimeError("socket closed")
+    wait_for(lambda: device.faulted)
+
+
+def test_hung_pmc_faults_after_staleness_limit(device, pmc, monkeypatch):
+    monkeypatch.setattr(device.api, "HEALTH_STALE_S", 0.2, raising=False)
+    device.initialize()
+    assert not device.faulted
+    pmc.gate.clear()
+    try:
+        wait_for(lambda: device.faulted, timeout=2.0)
+    finally:
+        pmc.gate.set()
+    # Answers again: the poller brings the fresh status back.
+    wait_for(lambda: not device.faulted)
+
+
+def test_shutdown_stops_polling(device, pmc):
+    device.initialize()
+    wait_for(lambda: pmc.status_calls > 3)
+    device.shutdown()
+    calls = pmc.status_calls
+    time.sleep(0.15)
+    assert pmc.status_calls == calls
+    assert not device.connected
+    assert not device.ready
+
+
+def test_not_connected_reads_nothing(device, pmc):
+    assert not device.connected
+    assert not device.ready
+    assert device.faulted
+    assert pmc.status_calls == 0
